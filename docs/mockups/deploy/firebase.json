{
  "hosting": {
    "target": "rental",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "rental",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test.js",
        "*.log"
      ]
    }
  ]
}
